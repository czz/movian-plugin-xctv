#import "skin://theme.view"
#import "skin://styles/style_grid.view"

// XCtv browse — sezioni Film / Serie TV:
//   [rail categorie | griglia poster]
// La rail e' page.model.groups (xidx/sel), i poster sono
// page.model.nodes. Il cambio categoria e' in-place via
// model.eventSink "group:N" (come la pagina live).
// Left sulla rail apre il drawer app (model.menu).

$view.menu = 0;   // drawer sezioni app
$view.ctx  = 0;   // popup contestuale poster
$view.gctx = 0;   // popup contestuale gruppo (ordina/nascondi)

onEvent(back, { $view.ctx = 0; focus("postergrid"); }, $view.ctx);
onEvent(back, { $view.gctx = 0; focus("catlist"); }, $view.gctx && !$view.ctx);
onEvent(back, { $view.menu = 0; focus("catlist"); }, $view.menu && !$view.ctx && !$view.gctx);

widget(container_z, {

  // sfondo scuro
  widget(quad, {
    color: [0.05, 0.06, 0.08];
  });

  widget(container_x, {

    // ====== rail categorie ======
    widget(container_z, {
      width: 12em;

      // left oltre la rail -> drawer sezioni app 
      onEvent(left, { $view.menu = 1; focus("menulist"); }, !$view.menu);

      widget(quad, {
        color: [0.13, 0.16, 0.19];
        alpha: 0.97;
      });

      widget(container_y, {

        widget(label, {
          caption: _("Categorie");
          size: 1.05em;
          height: 2.5em;
          padding: [1em, 0];
          color: 0.95;
        });

        widget(list_y, {
          id: "catlist";
          navWrap: true;
          chaseFocus: true;
          filterConstraintY: true;

          cloner($self.model.groups, container_z, {
            height: 2.7em;
            focusable: true;
            selectOnFocus: true;

            suggestFocus($self.sel);

            ListItemBevel();
            ListItemHighlight();

            // prima ricarica i poster (i cloni vengono ricreati),
            // poi sposta il focus sulla griglia fresca
            onEvent(activate, {
              fireEvent(deliverEvent($parent.model.eventSink,
                                     fmt("group:%d", $self.xidx)));
              focus("postergrid");
            });

            // long-press: menu contestuale del gruppo — riordina,
            // nascondi, ripristina
            onEvent(itemMenu, {
              $view.gctx = 1;
              $view.ctxx = $self.xidx;
              $view.gctxhide = $self.metadata.canhide;
              focus("gctxlist");
            });

            widget(container_x, {
              padding: [1em, 0];
              spacing: 0.6em;

              widget(label, {
                caption: $self.metadata.title;
                size: 0.95em;
                color: 0.9;
                filterConstraintX: true;
                ellipsize: true;
                align: center;
              });

              widget(icon, {
                source: "skin://icons/ic_check_48px.svg";
                size: 1em;
                color: [0.13, 0.59, 0.95];
                hidden: !$self.sel;
              });
            });
          });
        });
      });
    });

    // ====== griglia poster ======
    widget(container_z, {
      weight: 1;
      filterConstraintX: true;

      widget(array, {

        id: "postergrid";
        margin: [0.8em, 0.8em, 0.8em, 0.8em];

        Xspacing: 0.7em;
        Yspacing: 0.7em;

        childTilesX: select($ui.aspect > 1, 7, 3);
        childTilesY: 4;
        chaseFocus: true;
        navWrap: true;

        clipOffsetTop: 1em;
        scrollThresholdTop: 2em;
        scrollThresholdBottom: $ui.universeBottomHeight;
        clipOffsetBottom: $ui.universeBottomHeight;
        clipAlpha: 0.2;
        clipBlur: 1;

        cloner($self.model.nodes, container_y, {

          focusable: $self.type != "separator";
          onEvent(activate, navOpen($self.url, void, $self, $parent.model, void, $parent.url),
                  $self.type != "separator");

          // righe di stato (Caricamento… / Nessun elemento /
          // errori): separator nascosto come tile ma con label
          widget(label, {
            caption: $self.metadata.title;
            hidden: $self.type != "separator";
            color: 0.6;
            size: 0.9em;
            padding: [0.5em, 0];
          });

          // long-press: menu contestuale sul poster
          // (Riproduci diretta o Dettagli — )
          onEvent(itemMenu, {
            $view.ctx = 1;
            $view.ctxplay = $self.metadata.playurl;
            $view.ctxinfo = $self.url;
            $view.ctxkey = $self.metadata.vodkey;
            focus("ctxlist");
          });

          widget(container_z, {
            hidden: $self.type == "separator";

            widget(quad, {
              color: [0.10, 0.12, 0.15];
              alpha: select(isNavFocused() + isHovered(), 1, 0.85);
            });

            widget(image, {
              source: $self.metadata.icon;
              style: "GridBackdrop";
            });

            // badge preferito in alto a sinistra
            widget(container_x, {
              align: left;
              hidden: !$self.metadata.fav;

              widget(container_z, {
                widget(quad, {
                  color: 0;
                  alpha: 0.75;
                });
                widget(icon, {
                  source: "skin://icons/ic_favorite_48px.svg";
                  size: 0.9em;
                  padding: [0.25em, 0.25em];
                  color: [1.0, 0.78, 0.16];
                });
              });
            });

            // badge rating in alto a destra
            widget(container_x, {
              align: right;
              hidden: isVoid($self.metadata.rating);

              widget(container_z, {
                widget(quad, {
                  color: 0;
                  alpha: 0.75;
                });
                widget(label, {
                  caption: fmt("%.1f", $self.metadata.rating * 1.0);
                  size: 0.7em;
                  padding: [0.35em, 0.1em];
                  color: [0.565, 0.792, 0.976];
                });
              });
            });

            widget(border, {
              border: 0.1em;
              color: select(isNavFocused(), [0.13, 0.59, 0.95], 0);
            });
          });

          widget(label, {
            style: "GridLabel";
            caption: $self.metadata.title;
            maxlines: 2;
            hidden: $self.type == "separator";
          });
        });
      });
    });
  });

  // ---- drawer sezioni app (stesso della pagina live) ----
  widget(container_x, {
    hidden: !$view.menu;

    widget(container_z, {
      width: 15em;

      widget(quad, {
        color: [0.09, 0.11, 0.14];
        alpha: 0.98;
      });

      widget(container_y, {

        widget(label, {
          caption: "XCtv";
          size: 1.2em;
          height: 2.2em;
          padding: [1em, 0];
          color: [0.565, 0.792, 0.976];
          font: "skin://fonts/RobotoCondensed-Light.ttf";
        });

        widget(list_y, {
          id: "menulist";
          navWrap: true;
          chaseFocus: true;
          filterConstraintY: true;

          cloner($self.model.menu, container_z, {
            height: 3em;
            focusable: true;
            selectOnFocus: true;

            ListItemBevel();
            ListItemHighlight();

            onEvent(activate,
                    navOpen($self.url),
                    $self.url != '');
            onEvent(activate, {
              $view.menu = 0;
              focus("postergrid");
            }, $self.url == '');

            onEvent(right, {
              $view.menu = 0;
              focus("postergrid");
            }, true);

            widget(container_x, {
              padding: [1em, 0];
              spacing: 0.8em;

              widget(icon, {
                source: $self.metadata.icon;
                size: 1.2em;
                color: select(isNavFocused(), [0.565, 0.792, 0.976], 0.7);
              });

              widget(label, {
                caption: $self.metadata.title;
                size: 1em;
                color: select(isNavFocused(), 1, 0.85);
                filterConstraintX: true;
                ellipsize: true;
                align: center;
              });
            });
          });
        });
      });
    });

    space(1);
  });

  // ---- popup contestuale poster (long-press) ----
  widget(container_z, {
    hidden: !$view.ctx;

    widget(quad, {
      color: 0;
      alpha: 0.4;
      onEvent(back, { $view.ctx = 0; focus("postergrid"); }, true);
    });

    widget(container_x, {
      align: center;

      widget(container_z, {
        width: 16em;

        widget(quad, {
          color: [0.11, 0.13, 0.16];
          alpha: 0.98;
        });
        widget(border, {
          border: 0.05em;
          color: 0.3;
        });

        widget(list_y, {
          id: "ctxlist";
          navWrap: true;
          filterConstraintY: true;

          // Riproduci diretta (solo VOD: le serie aprono gli episodi)
          widget(container_z, {
            hidden: isVoid($view.ctxplay) || $view.ctxplay == '';
            height: 2.8em;
            focusable: true;
            ListItemBevel();
            ListItemHighlight();

            onEvent(activate, {
              $view.ctx = 0;
              fireEvent(navOpen($view.ctxplay));
            });

            widget(label, {
              caption: _("Riproduci");
              padding: [1em, 0];
              size: 1em;
              align: center;
            });
          });

          // Dettagli
          widget(container_z, {
            height: 2.8em;
            focusable: true;
            ListItemBevel();
            ListItemHighlight();

            onEvent(activate, {
              $view.ctx = 0;
              fireEvent(navOpen($view.ctxinfo));
            });

            widget(label, {
              caption: _("Dettagli");
              padding: [1em, 0];
              size: 1em;
              align: center;
            });
          });

          // Preferito — compare nella rail "Preferiti"
          widget(container_z, {
            height: 2.8em;
            focusable: true;
            ListItemBevel();
            ListItemHighlight();

            onEvent(activate, {
              $view.ctx = 0;
              fireEvent(deliverEvent($self.model.eventSink,
                                     fmt("favitem:%s", $view.ctxkey)));
            });

            widget(label, {
              caption: _("Preferiti");
              padding: [1em, 0];
              size: 1em;
              align: center;
            });
          });

          // Nascondi elemento — ripristina dal menu del gruppo
          // o da Impostazioni
          widget(container_z, {
            height: 2.8em;
            focusable: true;
            ListItemBevel();
            ListItemHighlight();

            onEvent(activate, {
              $view.ctx = 0;
              fireEvent(deliverEvent($self.model.eventSink,
                                     fmt("hideitem:%s", $view.ctxkey)));
            });

            widget(label, {
              caption: _("Nascondi elemento");
              padding: [1em, 0];
              size: 1em;
              align: center;
            });
          });

          // Sposta su — il popup resta aperto per spostamenti
          // multipli (solo categorie riordinabili, v. canitemorder)
          widget(container_z, {
            hidden: !$self.model.canitemorder;
            height: 2.8em;
            focusable: true;
            ListItemBevel();
            ListItemHighlight();

            onEvent(activate, {
              fireEvent(deliverEvent($self.model.eventSink,
                                     fmt("imoveup:%s", $view.ctxkey)));
            });

            widget(label, {
              caption: _("Sposta su");
              padding: [1em, 0];
              size: 1em;
              align: center;
            });
          });

          // Sposta giu'
          widget(container_z, {
            hidden: !$self.model.canitemorder;
            height: 2.8em;
            focusable: true;
            ListItemBevel();
            ListItemHighlight();

            onEvent(activate, {
              fireEvent(deliverEvent($self.model.eventSink,
                                     fmt("imovedown:%s", $view.ctxkey)));
            });

            widget(label, {
              caption: _("Sposta giù");
              padding: [1em, 0];
              size: 1em;
              align: center;
            });
          });

          // Rinomina — titolo personalizzato (vuoto = originale)
          widget(container_z, {
            height: 2.8em;
            focusable: true;
            ListItemBevel();
            ListItemHighlight();

            onEvent(activate, {
              $view.ctx = 0;
              fireEvent(deliverEvent($self.model.eventSink,
                                     fmt("renameitem:%s", $view.ctxkey)));
            });

            widget(label, {
              caption: _("Rinomina");
              padding: [1em, 0];
              size: 1em;
              align: center;
            });
          });

          // Annulla — chiude il popup
          widget(container_z, {
            height: 2.8em;
            focusable: true;
            ListItemBevel();
            ListItemHighlight();

            onEvent(activate, {
              $view.ctx = 0;
              focus("postergrid");
            });

            widget(label, {
              caption: _("Annulla");
              padding: [1em, 0];
              size: 1em;
              align: center;
            });
          });
        });
      });

      space(1);
    });
  });

  // ---- popup contestuale gruppo (long-press sul gruppo) ----
  widget(container_z, {
    hidden: !$view.gctx;

    widget(quad, {
      color: 0;
      alpha: 0.4;
      onEvent(back, { $view.gctx = 0; focus("catlist"); }, true);
      onEvent(activate, { $view.gctx = 0; focus("catlist"); }, true);
    });

    widget(container_x, {
      align: center;

      widget(container_z, {
        width: 16em;

        widget(quad, {
          color: [0.11, 0.13, 0.16];
          alpha: 0.98;
        });
        widget(border, {
          border: 0.05em;
          color: 0.3;
        });

        widget(list_y, {
          id: "gctxlist";
          navWrap: true;
          filterConstraintY: true;

          // Sposta su — il popup resta aperto per spostamenti multipli
          widget(container_z, {
            height: 2.8em;
            focusable: true;
            ListItemBevel();
            ListItemHighlight();

            onEvent(activate, {
              fireEvent(deliverEvent($self.model.eventSink,
                                     fmt("gmoveup:%d", $view.ctxx)));
              $view.ctxx = clamp($view.ctxx - 1, 0, 9999);
            });

            widget(label, {
              caption: _("Sposta su");
              padding: [1em, 0];
              size: 1em;
              align: center;
            });
          });

          // Sposta giu'
          widget(container_z, {
            height: 2.8em;
            focusable: true;
            ListItemBevel();
            ListItemHighlight();

            onEvent(activate, {
              fireEvent(deliverEvent($self.model.eventSink,
                                     fmt("gmovedown:%d", $view.ctxx)));
              $view.ctxx = $view.ctxx + 1;
            });

            widget(label, {
              caption: _("Sposta giù");
              padding: [1em, 0];
              size: 1em;
              align: center;
            });
          });

          // Nascondi gruppo — non su Continua/Tutti
          widget(container_z, {
            hidden: !$view.gctxhide;
            height: 2.8em;
            focusable: true;
            ListItemBevel();
            ListItemHighlight();

            onEvent(activate, {
              $view.gctx = 0;
              fireEvent(deliverEvent($self.model.eventSink,
                                     fmt("hidegroup:%d", $view.ctxx)));
              focus("catlist");
            });

            widget(label, {
              caption: _("Nascondi gruppo");
              padding: [1em, 0];
              size: 1em;
              align: center;
            });
          });

          // Ripristina gruppi ed elementi nascosti
          widget(container_z, {
            height: 2.8em;
            focusable: true;
            ListItemBevel();
            ListItemHighlight();

            onEvent(activate, {
              $view.gctx = 0;
              fireEvent(deliverEvent($self.model.eventSink,
                                     "unhide:0"));
              focus("catlist");
            });

            widget(label, {
              caption: _("Ripristina nascosti");
              padding: [1em, 0];
              size: 1em;
              align: center;
            });
          });

          // Annulla — chiude il popup
          widget(container_z, {
            height: 2.8em;
            focusable: true;
            ListItemBevel();
            ListItemHighlight();

            onEvent(activate, {
              $view.gctx = 0;
              focus("catlist");
            });

            widget(label, {
              caption: _("Annulla");
              padding: [1em, 0];
              size: 1em;
              align: center;
            });
          });
        });
      });

      space(1);
    });
  });

  ScrollBar("postergrid", 4em, $ui.universeBottomHeight);

  // loader inline — il loader universale di universe.view sta a
  // zindex -999 sotto il quad opaco di sfondo: si replica qui
  widget(container_z, {
    hidden: iir($self.model.loading, 8) < 0.01;
    alpha: iir($self.model.loading, 8);
    widget(quad, {
      color: 0;
      alpha: 0.6;
    });
    widget(container_y, {
      space(1);
      widget(throbber, {});
      space(0.2);
      widget(label, {
        align: center;
        caption: $self.model.loadingStatus;
        bold: true;
      });
      space(1);
    });
  });
});
