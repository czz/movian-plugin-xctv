#import "skin://theme.view"
#import "skin://styles/style_list.view"

// XCtv settings / add-playlist — layout guida:
//   [rail sezioni | lista opzioni]
// La rail e' page.model.groups (xidx/sel), le opzioni sono
// page.model.nodes con metadata {id,title,value,hint,kind}.
// Activate -> model.eventSink "opt:<id>", Left sulla rail
// apre il drawer app (model.menu).

$view.menu = 0;

onEvent(back, { $view.menu = 0; focus("catlist"); }, $view.menu);

widget(container_z, {

  // sfondo scuro
  widget(quad, {
    color: [0.05, 0.06, 0.08];
  });

  widget(container_x, {

    // ====== rail sezioni ======
    widget(container_z, {
      width: 12em;

      // left oltre la rail -> drawer sezioni app 
      onEvent(left, { $view.menu = 1; focus("menulist"); }, !$view.menu);

      widget(quad, {
        color: [0.13, 0.16, 0.19];
        alpha: 0.97;
      });

      widget(container_y, {

        widget(label, {
          caption: $self.model.metadata.title;
          size: 1.05em;
          height: 2.5em;
          padding: [1em, 0];
          color: 0.95;
        });

        widget(list_y, {
          id: "catlist";
          navWrap: true;
          chaseFocus: true;
          filterConstraintY: true;

          cloner($self.model.groups, container_z, {
            height: 2.7em;
            focusable: true;
            selectOnFocus: true;
            suggestFocus($self.sel);

            ListItemBevel();
            ListItemHighlight();

            onEvent(activate, {
              fireEvent(deliverEvent($parent.model.eventSink,
                                     fmt("group:%d", $self.xidx)));
              focus("optlist");
            });

            widget(container_x, {
              padding: [1em, 0];
              spacing: 0.6em;

              widget(label, {
                caption: $self.metadata.title;
                size: 0.95em;
                color: 0.9;
                filterConstraintX: true;
                ellipsize: true;
                align: center;
              });

              widget(icon, {
                source: "skin://icons/ic_check_48px.svg";
                size: 1em;
                color: [0.13, 0.59, 0.95];
                hidden: !$self.sel;
              });
            });
          });
        });
      });
    });

    // ====== lista opzioni ======
    widget(container_z, {
      weight: 1;
      filterConstraintX: true;

      widget(list_y, {

        id: "optlist";
        navWrap: true;
        chaseFocus: true;
        filterConstraintY: true;

        clipOffsetTop: 1em;
        scrollThresholdTop: 2em;
        scrollThresholdBottom: $ui.universeBottomHeight;
        clipOffsetBottom: $ui.universeBottomHeight;

        cloner($self.model.nodes, container_z, {

          height: 3.4em;
          focusable: true;
          selectOnFocus: true;

          ListItemBevel();
          ListItemHighlight();

          onEvent(activate, {
            fireEvent(deliverEvent($parent.model.eventSink,
                                   fmt("opt:%s", $self.metadata.id)));
          });

          widget(container_x, {
            padding: [1.2em, 0];
            spacing: 0.8em;

            widget(container_y, {
              filterConstraintX: true;
              align: center;
              spacing: 0.15em;

              widget(label, {
                caption: $self.metadata.title;
                size: 0.95em;
                color: 0.95;
                filterConstraintX: true;
                ellipsize: true;
              });

              widget(label, {
                caption: $self.metadata.hint;
                size: 0.75em;
                color: 0.5;
                filterConstraintX: true;
                ellipsize: true;
                hidden: isVoid($self.metadata.hint) || $self.metadata.hint == '';
              });
            });

            // valore (text/choice) allineato a destra
            widget(label, {
              caption: $self.metadata.value;
              size: 0.85em;
              color: [0.565, 0.792, 0.976];
              align: right;
              hidden: $self.metadata.kind == 'bool' ||
                      $self.metadata.kind == 'action';
              filterConstraintX: true;
              ellipsize: true;
            });

            // check per i bool
            widget(icon, {
              source: "skin://icons/ic_check_48px.svg";
              size: 1.1em;
              color: [0.13, 0.59, 0.95];
              align: right;
              hidden: $self.metadata.kind != 'bool' || !$self.metadata.value;
            });

            // stato off per i bool
            widget(label, {
              caption: 'Off';
              size: 0.85em;
              color: 0.45;
              align: right;
              hidden: $self.metadata.kind != 'bool' || $self.metadata.value;
            });

            // freccia per le azioni
            widget(icon, {
              source: "skin://icons/ic_chevron_right_48px.svg";
              size: 1.1em;
              color: 0.5;
              align: right;
              hidden: $self.metadata.kind != 'action';
            });
          });
        });
      });
    });
  });

  // ====== drawer sezioni app ======
  widget(container_z, {
    hidden: !$view.menu;

    widget(quad, {
      color: 0;
      alpha: 0.4;
      onEvent(back, { $view.menu = 0; focus("catlist"); }, true);
    });

    widget(container_x, {

      widget(container_z, {
        width: 15em;

        widget(quad, {
          color: [0.09, 0.11, 0.14];
          alpha: 0.98;
        });

        widget(container_y, {

          widget(label, {
            caption: "XCtv";
            size: 1.2em;
            height: 2.2em;
            padding: [1em, 0];
            color: [0.565, 0.792, 0.976];
            font: "skin://fonts/RobotoCondensed-Light.ttf";
          });

          widget(list_y, {
            id: "menulist";
            navWrap: true;
            chaseFocus: true;
            filterConstraintY: true;

            cloner($self.model.menu, container_z, {
              height: 3em;
              focusable: true;
              selectOnFocus: true;

              ListItemBevel();
              ListItemHighlight();

              onEvent(activate,
                      navOpen($self.url),
                      $self.url != '');
              onEvent(activate, {
                $view.menu = 0;
                focus("catlist");
              }, $self.url == '');

              onEvent(right, {
                $view.menu = 0;
                focus("catlist");
              }, true);

              widget(container_x, {
                padding: [1em, 0];
                spacing: 0.8em;

                widget(icon, {
                  source: $self.metadata.icon;
                  size: 1.2em;
                  color: select(isNavFocused(), [0.565, 0.792, 0.976], 0.7);
                });

                widget(label, {
                  caption: $self.metadata.title;
                  size: 1em;
                  color: select(isNavFocused(), 1, 0.85);
                  filterConstraintX: true;
                  ellipsize: true;
                });
              });
            });
          });
        });
      });

      space(1);
    });
  });
});
