#import "skin://theme.view"
#import "skin://styles/style_list.view"

// XCtv series detail — poster + info in alto, lista episodi
// sotto . Ogni episodio e' un item video:
// OK -> play.

widget(container_z, {

  // sfondo
  widget(quad, {
    color: [0.05, 0.06, 0.08];
  });

  widget(container_x, {

    // ====== rail stagioni  ======
    widget(container_z, {
      width: 12em;

      widget(quad, {
        color: [0.13, 0.16, 0.19];
        alpha: 0.97;
      });

      widget(container_y, {

        widget(label, {
          caption: _("Stagioni");
          size: 1.05em;
          height: 2.5em;
          padding: [1em, 0];
          color: 0.95;
        });

        widget(list_y, {
          id: "catlist";
          navWrap: true;
          chaseFocus: true;
          filterConstraintY: true;

          cloner($self.model.groups, container_z, {
            height: 2.7em;
            focusable: true;
            selectOnFocus: true;

            suggestFocus($self.sel);

            ListItemBevel();
            ListItemHighlight();

            // prima ricarica gli episodi (i cloni vengono ricreati),
            // poi sposta il focus sulla lista fresca
            onEvent(activate, {
              fireEvent(deliverEvent($parent.model.eventSink,
                                     fmt("group:%d", $self.xidx)));
              focus("scrollable");
            });

            widget(container_x, {
              padding: [1em, 0];
              spacing: 0.6em;

              widget(label, {
                caption: $self.metadata.title;
                size: 0.95em;
                color: 0.9;
                filterConstraintX: true;
                ellipsize: true;
                align: center;
              });

              widget(icon, {
                source: "skin://icons/ic_check_48px.svg";
                size: 1em;
                color: [0.13, 0.59, 0.95];
                hidden: !$self.sel;
              });
            });
          });
        });
      });
    });

  widget(container_y, {
    filterConstraintX: true;

    // ---- header serie: poster + metadati ----
    widget(container_x, {
      padding: [1.2em, 1.2em, 1.2em, 0.6em];
      spacing: 1.2em;
      height: 9em;

      widget(container_z, {
        width: 6em;

        widget(quad, {
          color: [0.10, 0.12, 0.15];
        });
        widget(image, {
          source: $self.model.metadata.poster;
          aspectConstraint: true;
        });
        widget(border, {
          border: 0.08em;
          color: 0.3;
        });
      });

      widget(container_y, {
        filterConstraintX: true;
        spacing: 0.4em;
        align: top;

        widget(label, {
          caption: $self.model.metadata.title;
          size: 1.5em;
          filterConstraintX: true;
          ellipsize: true;
        });

        widget(container_x, {
          spacing: 1em;

          widget(label, {
            hidden: isVoid($self.model.metadata.genre);
            caption: $self.model.metadata.genre;
            size: 0.85em;
            color: [0.565, 0.792, 0.976];
          });

          widget(label, {
            hidden: isVoid($self.model.metadata.year);
            caption: $self.model.metadata.year;
            size: 0.85em;
            color: 0.7;
          });
        });

        widget(label, {
          caption: $self.model.metadata.description;
          size: 0.85em;
          color: 0.6;
          maxlines: 3;
          filterConstraintX: true;
        });
      });
    });

    // ---- episodi ----
    widget(list_y, {

      id: "scrollable";
      navWrap: true;
      chaseFocus: true;
      filterConstraintY: true;

      clipOffsetTop: 2em;
      scrollThresholdTop: 3em;
      scrollThresholdBottom: $ui.universeBottomHeight + 2em;
      clipOffsetBottom: $ui.universeBottomHeight;
      clipAlpha: 0.2;
      clipBlur: 1;

      cloner($self.model.nodes, container_z, {

        hidden: $self.type == "separator";
        height: 3.4em;

        focusable: true;
        onEvent(activate, navOpen($self.url, void, $self, $parent.model, void, $parent.url));

        widget(quad, {
          color: select(isNavFocused(), [0.10, 0.20, 0.30], [0.09, 0.11, 0.14]);
          alpha: select(isNavFocused(), 0.95, 0.8);
        });
        widget(border, {
          border: 0.05em;
          color: select(isNavFocused(), [0.13, 0.59, 0.95], 0.14);
        });

        widget(container_x, {
          padding: [0.9em, 0];
          spacing: 0.9em;

          // badge SxxExx
          widget(container_z, {
            width: 4.2em;
            height: 1.9em;
            align: center;

            widget(quad, {
              color: [0.13, 0.59, 0.95];
              alpha: select(isNavFocused(), 0.9, 0.35);
            });

            widget(label, {
              caption: fmt("S%02dE%02d",
                           $self.metadata.season.number,
                           $self.metadata.episode.number);
              size: 0.9em;
              color: 1;
              align: center;
            });
          });

          widget(icon, {
            source: "skin://icons/ic_check_48px.svg";
            size: 1em;
            color: [0.2, 0.75, 0.35];
            hidden: !$self.metadata.watched;
          });

          widget(label, {
            caption: $self.metadata.episode.title;
            size: 1em;
            color: select(isNavFocused(), 1,
                          select($self.metadata.watched, 0.55, 0.9));
            filterConstraintX: true;
            ellipsize: true;
            align: center;
          });

          widget(label, {
            hidden: isVoid($self.metadata.duration);
            caption: $self.metadata.duration;
            size: 0.85em;
            color: 0.55;
          });
        });
      });
    });
    });
  });

  ScrollBar("scrollable", 9em, $ui.universeBottomHeight);
});
